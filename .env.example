# Copy this file to .env. Never put this key in a VITE_ variable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
SERVER_PORT=8080
# Required when using paid recognition in production. Enter the same value in Settings.
APP_ACCESS_KEY=
# Use prod when deploying publicly. A key is required for paid recognition in prod.
SPRING_PROFILES_ACTIVE=local

# Supabase: Connect > Session pooler (5432). Keep false until all values are filled.
DB_ENABLED=false
DB_URL=
DB_USERNAME=
DB_PASSWORD=
# DB_URL example: jdbc:postgresql://YOUR_POOLER_HOST:5432/postgres?sslmode=require&connectTimeout=10&socketTimeout=30
# DB_USERNAME example: postgres.YOUR_PROJECT_REF
# APP_ACCESS_KEY is required for database access. Enter it in the app's Settings too.
